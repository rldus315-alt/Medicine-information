// 공공데이터포털 API 키 설정 (선택사항)
// https://www.data.go.kr 에서 활용신청 후 발급받은 인증키를 입력하세요.
// 이 파일을 config.js로 복사한 뒤 API 키를 입력하세요.
// API 키가 없어도 로컬 DB + OpenFDA로 의약품 검색이 가능합니다.

// 의약품개요정보(e약은요): 의약품 상세정보
const DATA_GO_KR_API_KEY = '';

// 국립중앙의료원 전국 약국정보조회: 근처 약국 검색
// 비워두면 DATA_GO_KR_API_KEY를 사용합니다. (같은 인증키로 활용 가능)
const DATA_GO_KR_PHARMACY_API_KEY = '';

// 의약품낱알정보식별조회: 알약 식별 및 낱알 이미지
// 비워두면 DATA_GO_KR_API_KEY를 사용합니다.
const DATA_GO_KR_PILL_API_KEY = '';
